---
/**
 * Shared detail-page layout for all five collections. Renders the entry
 * via `render()`, a collection-specific info panel (only rendered when it
 * has real fields to show), the prose body, and a footer with edit-on-
 * GitHub / copy-link / prev-next / related posts.
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Prose from '@/components/ui/Prose.astro';
import { mdxComponents } from '@/components/mdx';
import PostHeader from '@/components/content/PostHeader.astro';
import Toc from '@/components/content/Toc.astro';
import ReadingProgress from '@/components/content/ReadingProgress.astro';
import PrevNext from '@/components/content/PrevNext.astro';
import RelatedPosts from '@/components/content/RelatedPosts.astro';
import CopyButton from '@/components/content/CopyButton.astro';
import WriteupInfoPanel from '@/components/content/WriteupInfoPanel.astro';
import ResearchInfoPanel from '@/components/content/ResearchInfoPanel.astro';
import ProjectInfoPanel from '@/components/content/ProjectInfoPanel.astro';
import CheatsheetPanel from '@/components/content/CheatsheetPanel.astro';
import { getAdjacent, getRelated, entryDescription, type AnyEntry } from '@/lib/collections';
import { siteConfig } from '@/lib/site';
import { Pencil } from '@lucide/astro';

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;

const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const { prev, next } = await getAdjacent(entry);
const related = await getRelated(entry, 3);
const description = entryDescription(entry);
const editUrl = entry.filePath
  ? `https://github.com/${siteConfig.repo.owner}/${siteConfig.repo.name}/edit/${siteConfig.repo.branch}/${entry.filePath}`
  : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={description || entry.data.title}
  image={entry.data.cover}
  type="article"
  publishedTime={entry.data.date}
  updatedTime={entry.data.updated}
>
  <ReadingProgress />
  <Container as="article" class="py-10 sm:py-14">
    <PostHeader entry={entry} description={description} />

    <div class="mt-10 gap-10 xl:grid xl:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="min-w-0 max-w-3xl">
        {tocHeadings.length > 0 && (
          <details class="mb-8 rounded-xl border border-line bg-elevated p-4 xl:hidden">
            <summary class="cursor-pointer select-none font-mono text-sm font-medium text-fg">On this page</summary>
            <Toc headings={tocHeadings} variant="mobile" />
          </details>
        )}

        {entry.collection === 'writeups' && <WriteupInfoPanel data={entry.data} />}
        {entry.collection === 'research' && <ResearchInfoPanel data={entry.data} />}
        {entry.collection === 'projects' && <ProjectInfoPanel data={entry.data} />}
        {entry.collection === 'cheatsheets' && <CheatsheetPanel sections={entry.data.sections} />}

        <Prose>
          <Content components={mdxComponents} />
        </Prose>

        <footer class="mt-12 space-y-8 border-t border-line pt-8">
          <div class="flex flex-wrap items-center gap-4">
            {editUrl && (
              <a
                href={editUrl}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-xs text-subtle transition-colors hover:text-accent"
              >
                <Pencil class="size-3.5" /> Edit this page on GitHub
              </a>
            )}
            <CopyButton label="Copy link" />
          </div>

          <PrevNext prev={prev} next={next} />
          <RelatedPosts entries={related} />
        </footer>
      </div>

      {tocHeadings.length > 0 && (
        <aside class="hidden xl:block">
          <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-8">
            <Toc headings={tocHeadings} variant="desktop" />
          </div>
        </aside>
      )}
    </div>
  </Container>
</BaseLayout>
