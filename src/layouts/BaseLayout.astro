---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SearchPalette from '@/components/search/SearchPalette';
import { siteConfig } from '@/lib/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? '/og-default.png', Astro.site).toString();
---

<!doctype html>
<html lang="en" class="scroll-pt-16">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme handling. Runs before first paint (no flash) and is kept in sync
         across <ClientRouter /> soft navigations: Astro swaps <html> attributes
         on navigation, which would drop the `dark` class, so we re-apply the
         stored theme to the incoming document on `astro:before-swap` (no flash)
         and again on `astro:after-swap`. This script is not re-run on soft nav,
         so listeners are registered exactly once. -->
    <script is:inline>
      (function () {
        if (window.__setTheme) return;
        var KEY = 'theme';
        function stored() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        }
        function current() {
          return (
            stored() ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          );
        }
        function paint(root, theme) {
          root.classList.toggle('dark', theme === 'dark');
          root.style.colorScheme = theme;
        }
        function apply(theme) {
          paint(document.documentElement, theme);
          var color = theme === 'dark' ? '#09090b' : '#fafafa';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute('content', color);
          });
          document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
            b.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
          });
        }
        window.__setTheme = function (theme) {
          try {
            localStorage.setItem(KEY, theme);
          } catch (e) {}
          apply(theme);
        };
        window.__toggleTheme = function () {
          window.__setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
        };
        apply(current());
        document.addEventListener('astro:before-swap', function (e) {
          paint(e.newDocument.documentElement, current());
        });
        document.addEventListener('astro:after-swap', function () {
          apply(current());
        });
        document.addEventListener('astro:page-load', function () {
          apply(current());
        });
        window.addEventListener('storage', function (e) {
          if (e.key === KEY) apply(current());
        });
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', function () {
            if (!stored()) apply(current());
          });
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && updatedTime && (
      <meta property="article:modified_time" content={updatedTime.toISOString()} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg font-sans text-fg antialiased selection:bg-accent selection:text-accent-fg">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg border border-line bg-elevated px-4 py-2 text-sm text-fg focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>

    <div aria-hidden="true" class="bg-grid bg-glow pointer-events-none fixed inset-x-0 top-0 -z-10 h-[32rem]">
    </div>

    <div class="relative flex min-h-screen flex-col">
      <Header />
      <main id="main" class="min-h-screen min-h-svh flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <SearchPalette client:idle transition:persist />

    <!-- Shared cursor-spotlight for [data-spotlight] cards. Delegated on
         `document`, so it keeps working across view transitions with no
         re-init needed. -->
    <script is:inline>
      (function () {
        document.addEventListener('pointermove', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('[data-spotlight]') : null;
          if (!el) return;
          var rect = el.getBoundingClientRect();
          el.style.setProperty('--spotlight-x', ((e.clientX - rect.left) / rect.width) * 100 + '%');
          el.style.setProperty('--spotlight-y', ((e.clientY - rect.top) / rect.height) * 100 + '%');
        });

        // Mac vs. other: swap the search shortcut hint. Runs once, then
        // again after every view-transition navigation (astro:page-load),
        // since the swapped-in page may contain fresh [data-kbd-hint] nodes.
        function updateKbdHints() {
          var isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent || '');
          document.querySelectorAll('[data-kbd-hint]').forEach(function (el) {
            el.textContent = isMac ? '⌘K' : 'Ctrl K';
          });
        }
        updateKbdHints();
        document.addEventListener('astro:page-load', updateKbdHints);

        // Close the native <details> mobile menu after any navigation.
        document.addEventListener('astro:page-load', function () {
          document.querySelectorAll('[data-mobile-nav][open]').forEach(function (el) {
            el.removeAttribute('open');
          });
        });
      })();
    </script>
  </body>
</html>
