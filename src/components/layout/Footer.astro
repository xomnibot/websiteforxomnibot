---
import Container from '@/components/ui/Container.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { nav, siteConfig } from '@/lib/site';
import { Mail } from '@lucide/astro';

const year = new Date().getFullYear();

const socialLinks = [
  { href: siteConfig.socials.github, label: 'GitHub', brand: 'github' as const },
  { href: siteConfig.socials.youtube, label: 'YouTube', brand: 'youtube' as const },
  { href: siteConfig.socials.linkedin, label: 'LinkedIn', brand: 'linkedin' as const },
  { href: siteConfig.socials.x, label: 'X', brand: 'x' as const },
];
---

<footer class="border-t border-line">
  <Container class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-base font-semibold text-fg">
        <span class="text-accent">&gt;_</span> xomnibot
      </a>
      <p class="mt-3 max-w-sm text-sm text-muted">{siteConfig.description}</p>
      <div class="mt-5 flex items-center gap-2">
        {
          socialLinks.map(({ href, label, brand }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer"
              aria-label={label}
              class="inline-flex size-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent/40 hover:text-accent"
            >
              <BrandIcon name={brand} />
            </a>
          ))
        }
        <a
          href={`mailto:${siteConfig.socials.email}`}
          aria-label="Email"
          class="inline-flex size-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent/40 hover:text-accent"
        >
          <Mail class="size-4" />
        </a>
      </div>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-subtle">Content</p>
      <ul class="mt-4 space-y-2.5">
        {
          nav.primary.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-muted hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-subtle">More</p>
      <ul class="mt-4 space-y-2.5">
        {
          nav.secondary.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-muted hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <div class="border-t border-line py-6">
    <Container class="flex flex-col items-center justify-between gap-2 text-xs text-subtle sm:flex-row">
      <p>&copy; {year} xomnibot. All rights reserved.</p>
      <p>Built with Astro &middot; Hosted on Vercel</p>
    </Container>
  </div>
</footer>
