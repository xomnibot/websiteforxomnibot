---
import Container from '@/components/ui/Container.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { nav, siteConfig } from '@/lib/site';
import { Mail } from '@lucide/astro';

const year = new Date().getFullYear();

const socialLinks = [
  { href: siteConfig.socials.github, label: 'GitHub', brand: 'github' as const },
  { href: siteConfig.socials.linkedin, label: 'LinkedIn', brand: 'linkedin' as const },
  { href: siteConfig.socials.youtube, label: 'YouTube', brand: 'youtube' as const },
  { href: siteConfig.socials.instagram, label: 'Instagram', brand: 'instagram' as const },
];
---

<footer class="mt-24 border-t border-line bg-elevated/40 sm:mt-32">
  <Container class="grid gap-14 py-20 sm:grid-cols-2 lg:grid-cols-4 lg:gap-16 lg:py-24">
    <div class="lg:col-span-2">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-base font-semibold text-fg">
        <span class="text-accent">&gt;_</span> xomnibot
      </a>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted text-pretty">{siteConfig.description}</p>
      <div class="mt-7 flex items-center gap-3">
        {
          socialLinks.map(({ href, label, brand }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer"
              aria-label={label}
              class="inline-flex size-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent/40 hover:text-accent"
            >
              <BrandIcon name={brand} />
            </a>
          ))
        }
        <a
          href={`mailto:${siteConfig.socials.email}`}
          aria-label="Email"
          class="inline-flex size-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent/40 hover:text-accent"
        >
          <Mail class="size-4" />
        </a>
      </div>
    </div>

    <div>
      <p class="eyebrow text-subtle">Content</p>
      <ul class="mt-6 space-y-4">
        {
          nav.primary.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-muted transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="eyebrow text-subtle">More</p>
      <ul class="mt-6 space-y-4">
        {
          nav.secondary.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-muted transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <div class="border-t border-line py-8">
    <Container class="flex flex-col items-center justify-between gap-2 text-xs text-subtle sm:flex-row">
      <p>&copy; {year} xomnibot. All rights reserved.</p>
    </Container>
  </div>
</footer>
