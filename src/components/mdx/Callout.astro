---
import { Info, Lightbulb, TriangleAlert, CircleAlert } from '@lucide/astro';

export type CalloutType = 'note' | 'tip' | 'warning' | 'danger' | 'info';

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = 'note', title } = Astro.props;

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const config: Record<CalloutType, { icon: any; classes: string; defaultTitle: string }> = {
  note: { icon: Info, classes: 'border-line-strong bg-surface', defaultTitle: 'Note' },
  info: { icon: Info, classes: 'border-blue/30 bg-blue/10', defaultTitle: 'Info' },
  tip: { icon: Lightbulb, classes: 'border-green/30 bg-green/10', defaultTitle: 'Tip' },
  warning: { icon: TriangleAlert, classes: 'border-amber/30 bg-amber/10', defaultTitle: 'Warning' },
  danger: { icon: CircleAlert, classes: 'border-red/30 bg-red/10', defaultTitle: 'Danger' },
};

const { icon: Icon, classes, defaultTitle } = config[type] ?? config.note;
---

<div class={`not-prose my-6 flex gap-3 rounded-xl border p-4 text-fg ${classes}`} role="note">
  <Icon class="mt-0.5 size-5 shrink-0" />
  <div class="min-w-0 text-sm leading-relaxed">
    <p class="mb-1 font-semibold">{title ?? defaultTitle}</p>
    <div
      class="text-muted [&_a]:text-accent [&_a]:underline [&_code]:rounded [&_code]:bg-elevated [&_code]:px-1 [&_code]:py-0.5 [&_code]:text-fg [&>*+*]:mt-2"
    >
      <slot />
    </div>
  </div>
</div>
