---
import { cn } from '@/lib/utils';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  action?: { label: string; href: string };
  class?: string;
}

const { eyebrow, title, description, action, class: className } = Astro.props;
---

<div class={cn('flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between', className)}>
  <div class="max-w-2xl">
    {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-accent">{eyebrow}</p>}
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{title}</h2>
    {description && <p class="mt-2 text-muted">{description}</p>}
  </div>
  {
    action && (
      <a
        href={action.href}
        class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-accent underline-offset-4 hover:underline"
      >
        {action.label}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    )
  }
</div>
