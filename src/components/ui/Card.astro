---
import { cn } from '@/lib/utils';

interface Props {
  href?: string;
  class?: string;
  /** Cursor-following spotlight highlight. Default true. */
  spotlight?: boolean;
}

const { href, class: className, spotlight = true } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  data-spotlight={spotlight ? '' : undefined}
  class={cn(
    'group relative block overflow-hidden rounded-xl border border-line bg-elevated p-5 transition-all duration-200',
    href && 'hover:-translate-y-0.5 hover:border-accent/40',
    className,
  )}
>
  <div class="relative z-[2]">
    <slot />
  </div>
</Tag>
