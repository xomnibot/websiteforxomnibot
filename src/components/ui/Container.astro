---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'nav' | 'main';
}

const { class: className, as: Tag = 'div' } = Astro.props;
---

<Tag class={cn('mx-auto w-full max-w-6xl px-4 sm:px-6', className)}>
  <slot />
</Tag>
