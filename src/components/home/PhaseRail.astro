---
/** Kill-chain progress rail (>=1280px). Lights the node of the section in view; the line fills as you scroll. */
import { phases } from './phases';
---

<nav id="phase-rail" aria-label="Page sections" class="phase-rail">
  <div class="rail-line" aria-hidden="true"><div class="rail-fill"></div></div>
  {
    phases.map((p, i) => (
      <a href={`#${p.id}`} data-rail-node={p.id} class="rail-node" style={`--i:${i / (phases.length - 1)}`} aria-label={`${p.num} ${p.name}`}>
        <span class="rail-dot" aria-hidden="true"></span>
        <span class="rail-label" aria-hidden="true">{p.num}</span>
        <span class="rail-tip" aria-hidden="true">{p.name}</span>
      </a>
    ))
  }
</nav>

<style>
  .phase-rail {
    display: none;
  }
  @media (min-width: 1280px) {
    .phase-rail {
      display: block;
      position: fixed;
      left: 14px;
      top: 50%;
      height: min(56vh, 30rem);
      width: 2.75rem;
      transform: translateY(-50%);
      z-index: 30;
    }
    .rail-line {
      position: absolute;
      left: 5px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--border-strong);
      border-radius: 2px;
    }
    .rail-fill {
      width: 100%;
      height: 0;
      background: var(--accent);
      border-radius: 2px;
      transition: height 120ms linear;
    }
    .rail-node {
      position: absolute;
      top: calc(var(--i) * 100%);
      left: 0;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      height: 2.5rem;
      color: var(--fg-subtle);
      text-decoration: none;
    }
    .rail-dot {
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      background: var(--bg);
      border: 2px solid var(--border-strong);
      transition: all 250ms ease;
      flex: none;
    }
    .rail-label {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      transition: color 250ms;
    }
    .rail-tip {
      position: absolute;
      left: 3.25rem;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-4px);
      transition: all 180ms;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      color: var(--fg);
      background: var(--bg-elevated);
      border: 1px solid var(--border-strong);
      border-radius: 6px;
      padding: 2px 8px;
      white-space: nowrap;
    }
    .rail-node:hover .rail-tip,
    .rail-node:focus-visible .rail-tip {
      opacity: 1;
      transform: none;
    }
    .rail-node:hover .rail-dot {
      border-color: var(--accent);
    }
    .rail-node.is-passed .rail-dot {
      border-color: var(--accent);
    }
    .rail-node.is-active .rail-dot {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
    }
    .rail-node.is-active .rail-label {
      color: var(--accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-fill, .rail-dot, .rail-label, .rail-tip { transition: none; }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;
    const rail = document.getElementById('phase-rail');
    if (!rail) return;
    const nodes = Array.from(rail.querySelectorAll<HTMLElement>('[data-rail-node]'));
    const secs = nodes.map((n) => document.getElementById(n.dataset.railNode!));
    if (secs.some((s) => !s)) return;
    const fill = rail.querySelector<HTMLElement>('.rail-fill')!;
    const last = nodes.length - 1;
    let raf = 0;

    const update = () => {
      raf = 0;
      const ref = window.innerHeight * 0.4;
      const tops = secs.map((s) => s!.getBoundingClientRect().top);
      let active = 0;
      for (let i = 0; i <= last; i++) if (tops[i] <= ref) active = i;
      // bottom of page => last node
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) active = last;
      let frac = 0;
      if (active < last) frac = Math.min(1, Math.max(0, (ref - tops[active]) / (tops[active + 1] - tops[active])));
      const p = active === last && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4 ? 1 : (active + frac) / last;
      fill.style.height = `${Math.min(1, p) * 100}%`;
      nodes.forEach((n, i) => {
        n.classList.toggle('is-active', i === active);
        n.classList.toggle('is-passed', i < active);
        if (i === active) n.setAttribute('aria-current', 'true');
        else n.removeAttribute('aria-current');
      });
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    const onClick = (e: Event) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-rail-node]');
      if (!a) return;
      e.preventDefault();
      const sec = document.getElementById(a.dataset.railNode!);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      sec?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    rail.addEventListener('click', onClick);
    update();
    cleanup = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      rail.removeEventListener('click', onClick);
      if (raf) cancelAnimationFrame(raf);
    };
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
