---
/** 03 // ESCALATE: featured projects as compact cards. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import { statusTone } from '@/lib/badges';
import { featuredProjects } from '@/data/about';
import { ArrowUpRight } from '@lucide/astro';
import { phaseLabel } from './phases';

const projects = featuredProjects.slice(0, 4);
---

<div data-reveal>
  <SectionHeading
    eyebrow={phaseLabel('escalate')}
    title="Things I've built"
    description="Tools and labs that grew out of getting stuck on something and wanting it to never happen again."
    action={{ label: 'See everything on About', href: '/about' }}
  />
</div>

<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    projects.map((p) => (
      <a
        data-reveal
        href={p.link ?? '/about'}
        class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-elevated p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl hover:shadow-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:hover:shadow-black/50"
      >
        <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        <div class="flex items-start justify-between gap-3">
          <Badge tone={statusTone(p.status)}>{p.status}</Badge>
          <ArrowUpRight class="size-4 text-subtle transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />
        </div>
        <h3 class="mt-5 text-lg font-semibold tracking-tight text-fg transition-colors group-hover:text-accent">{p.name}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{p.summary}</p>
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
          {p.stack.slice(0, 4).map((s) => (
            <li class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-muted">{s}</li>
          ))}
        </ul>
      </a>
    ))
  }
</div>
