---
/** "Browse by collection" tiles with live entry counts. */
import { collectionMeta, type CollectionKey } from '@/lib/collections';
import { COLLECTIONS } from '@/lib/schemas';
import { ShieldHalf, FlaskConical, FolderGit2, NotebookPen, Terminal as TerminalIcon, ArrowUpRight } from '@lucide/astro';

interface Props {
  counts: Record<CollectionKey, number>;
  class?: string;
}

const { counts, class: className = '' } = Astro.props;

const icons: Record<CollectionKey, typeof ShieldHalf> = {
  writeups: ShieldHalf,
  research: FlaskConical,
  projects: FolderGit2,
  blog: NotebookPen,
  cheatsheets: TerminalIcon,
};
---

<div class={`grid gap-4 sm:grid-cols-2 lg:grid-cols-6 ${className}`}>
  {
    COLLECTIONS.map((key, i) => {
      const meta = collectionMeta[key];
      const Icon = icons[key];
      const count = counts[key] ?? 0;
      return (
        <a
          href={meta.href}
          class={`group flex flex-col gap-4 ${i < 3 ? "lg:col-span-2" : "lg:col-span-3"} rounded-xl border border-line bg-elevated p-5 transition-colors hover:border-line-strong hover:bg-surface`}
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface text-accent">
              <Icon class="size-5" />
            </span>
            <span class="font-mono text-xs text-subtle">
              {count} {count === 1 ? 'post' : 'posts'}
            </span>
          </div>
          <div>
            <h3 class="flex items-center gap-1.5 font-semibold text-fg">
              {meta.label}
              <ArrowUpRight class="size-4 text-subtle transition-colors group-hover:text-accent" />
            </h3>
            <p class="mt-1.5 text-sm text-muted">{meta.description}</p>
          </div>
        </a>
      );
    })
  }
</div>
