---
/** 01 // ENUMERATE: honest numbers + a two-row toolbox ticker. */
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { phaseLabel } from './phases';

interface Props {
  stats: readonly { label: string; value: string; count?: boolean }[];
}
const { stats } = Astro.props;

const rowA = ['Burp Suite', 'nmap', 'Ghidra', 'BloodHound', 'Impacket', 'NetExec', 'gobuster', 'Wireshark', 'pwndbg'];
const rowB = ['Wazuh', 'Suricata', 'Sysmon', 'Python', 'Go', 'Rust', 'Docker', 'Ansible', 'Linux'];
const rows = [
  { items: rowA, reverse: false },
  { items: rowB, reverse: true },
];
---

<Container>
  <div data-reveal>
    <SectionHeading
      eyebrow={phaseLabel('enumerate')}
      title="The numbers, and the toolbox"
      description="What I've shipped so far, and what I reach for when I sit down at a target."
    />
  </div>
  <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4">
    {
      stats.map((s) => (
        <div data-reveal class="bg-elevated px-5 py-7 sm:px-7 sm:py-8">
          <dd data-countup={s.count ? s.value : undefined} class="font-mono text-4xl font-semibold tracking-tight text-fg sm:text-5xl">{s.value}</dd>
          <dt class="eyebrow mt-3 !text-[0.6875rem] text-muted">{s.label}</dt>
        </div>
      ))
    }
  </dl>
</Container>

<div data-reveal class="ticker mt-14 space-y-3" aria-label="Tools and technologies I use">
  {
    rows.map((row) => (
      <div class="ticker-row overflow-hidden">
        <ul class:list={['ticker-track', row.reverse && 'is-reverse']}>
          {[0, 1].map((copy) =>
            row.items.map((t) => (
              <li aria-hidden={copy === 1 ? 'true' : undefined} data-dup={copy === 1 ? '' : undefined} class="ticker-chip">
                {t}
              </li>
            )),
          )}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .ticker-row {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding-right: 0.75rem;
    list-style: none;
    margin: 0;
    padding-left: 0;
  }
  .ticker-chip {
    flex: none;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg-muted);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    white-space: nowrap;
    transition: color 150ms, border-color 150ms;
  }
  .ticker-chip:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: ticker-scroll 60s linear infinite;
    }
    .ticker-track.is-reverse {
      animation-direction: reverse;
      animation-duration: 70s;
    }
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-row {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .ticker-track {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 1rem;
    }
    .ticker-chip[data-dup] {
      display: none;
    }
  }
</style>
