---
/** Chronological list across collections: date, collection, title, reading time. */
import type { AnyEntry } from '@/lib/collections';
import { collectionMeta, entryHref, entryReadingTime } from '@/lib/collections';
import { formatDate } from '@/lib/utils';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  entries: AnyEntry[];
}
const { entries } = Astro.props;
---

<ul class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-elevated">
  {
    entries.map((entry) => (
      <li>
        <a
          href={entryHref(entry)}
          class="group grid gap-x-6 gap-y-1 px-5 py-4 transition-colors hover:bg-surface sm:grid-cols-[7rem_7rem_1fr_auto] sm:items-center"
        >
          <time datetime={entry.data.date.toISOString()} class="font-mono text-xs text-subtle">
            {formatDate(entry.data.date)}
          </time>
          <span class="font-mono text-xs uppercase tracking-widest text-accent">
            {collectionMeta[entry.collection].singular}
          </span>
          <span class="font-medium text-fg group-hover:text-accent">{entry.data.title}</span>
          <span class="hidden items-center gap-2 font-mono text-xs text-subtle sm:flex">
            {entryReadingTime(entry)}
            <ArrowUpRight class="size-3.5" />
          </span>
          <span class="font-mono text-xs text-subtle sm:hidden">{entryReadingTime(entry)}</span>
        </a>
      </li>
    ))
  }
</ul>
