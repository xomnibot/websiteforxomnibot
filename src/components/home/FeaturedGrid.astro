---
/** Up to three featured entries as equal cover cards. */
import type { AnyEntry } from '@/lib/collections';
import { collectionMeta, entryHref, entryDescription, entryReadingTime } from '@/lib/collections';
import { ImageIcon } from '@lucide/astro';

interface Props {
  entries: AnyEntry[];
}
const { entries } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
  {
    entries.map((entry) => (
      <a
        href={entryHref(entry)}
        class="group flex flex-col overflow-hidden rounded-xl border border-line bg-elevated transition-colors hover:border-line-strong"
      >
        <div class="aspect-[16/9] overflow-hidden border-b border-line bg-surface">
          {entry.data.cover ? (
            <img
              src={entry.data.cover}
              alt={entry.data.coverAlt ?? ''}
              loading="lazy"
              class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex size-full items-center justify-center text-subtle">
              <ImageIcon class="size-8" />
            </div>
          )}
        </div>
        <div class="flex flex-1 flex-col p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-accent">
            {collectionMeta[entry.collection].singular}
          </p>
          <h3 class="mt-2 text-lg font-semibold leading-snug tracking-tight text-fg">{entry.data.title}</h3>
          <p class="mt-2 line-clamp-2 text-sm text-muted">{entryDescription(entry)}</p>
          <p class="mt-auto pt-4 font-mono text-xs text-subtle">{entryReadingTime(entry)}</p>
        </div>
      </a>
    ))
  }
</div>
