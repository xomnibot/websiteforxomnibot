---
/**
 * Interactive terminal window for the hero. Every line is fully rendered
 * server-side (real data, real links) so it works with no JS, reduced
 * motion, and crawlers. When JS + motion are available, a small script
 * "types" the already-present command text and reveals the output that
 * follows it, then loops. Nothing is ever injected that wasn't already in
 * the static markup.
 */
import { Circle } from '@lucide/astro';

export interface TerminalLine {
  cmd: string;
  /** Output rendered as an Astro slot-free HTML string built by the caller — kept as plain lines for safety. */
  output: string[];
}

interface Props {
  lines: TerminalLine[];
  class?: string;
}

const { lines, class: className = '' } = Astro.props;
---

<div class={`relative overflow-hidden rounded-xl border border-line bg-elevated shadow-2xl shadow-black/10 ${className}`} data-terminal>
  <div class="flex items-center gap-2 border-b border-line bg-surface px-4 py-3">
    <span class="size-3 rounded-full bg-red/60"></span>
    <span class="size-3 rounded-full bg-amber/60"></span>
    <span class="size-3 rounded-full bg-green/60"></span>
    <p class="ml-2 flex items-center gap-1.5 font-mono text-xs text-subtle">
      <Circle class="size-2 fill-accent text-accent" />
      xomnibot@lab: ~
    </p>
  </div>

  <div class="space-y-4 p-5 font-mono text-[13px] leading-relaxed sm:text-sm" aria-live="off">
    {
      lines.map((line) => (
        <div data-term-line>
          <p class="flex flex-wrap items-start gap-1.5">
            <span class="shrink-0 text-accent">❯</span>
            <span data-term-cmd data-full={line.cmd} class="text-fg">
              {line.cmd}
            </span>
            <span class="term-caret inline-block h-[1em] w-[7px] translate-y-[2px] bg-accent align-middle" aria-hidden="true" />
          </p>
          <div data-term-output class="mt-1.5 whitespace-pre-wrap pl-4 text-muted">
            {line.output.map((row) => <p>{row}</p>)}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  [data-term-line] .term-caret {
    animation: term-blink 1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-term-line] .term-caret {
      animation: none;
      opacity: 0;
    }
  }
  @keyframes term-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  let termTimer: ReturnType<typeof setTimeout> | undefined;

  function initTerminal() {
    clearTimeout(termTimer);
    const root = document.querySelector<HTMLElement>('[data-terminal]');
    if (!root) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = Array.from(root.querySelectorAll<HTMLElement>('[data-term-line]'));

    // Reset to the fully-rendered static state first (also the permanent
    // state when motion is reduced / re-init happens on a page without JS
    // timing quirks).
    lines.forEach((line) => {
      const cmdEl = line.querySelector<HTMLElement>('[data-term-cmd]');
      const outEl = line.querySelector<HTMLElement>('[data-term-output]');
      if (cmdEl) cmdEl.textContent = cmdEl.dataset.full ?? '';
      if (outEl) outEl.style.display = '';
    });

    if (reduce || lines.length === 0) return;

    let i = 0;
    function typeLine() {
      if (i >= lines.length) {
        termTimer = setTimeout(() => {
          i = 0;
          typeLine();
        }, 3200);
        return;
      }
      const line = lines[i];
      const cmdEl = line.querySelector<HTMLElement>('[data-term-cmd]');
      const outEl = line.querySelector<HTMLElement>('[data-term-output]');
      const full = cmdEl?.dataset.full ?? '';
      if (outEl) outEl.style.display = 'none';
      if (cmdEl) cmdEl.textContent = '';
      let ci = 0;
      function typeChar() {
        if (!cmdEl) return;
        if (ci <= full.length) {
          cmdEl.textContent = full.slice(0, ci);
          ci += 1;
          termTimer = setTimeout(typeChar, 26);
        } else {
          if (outEl) outEl.style.display = '';
          termTimer = setTimeout(() => {
            i += 1;
            typeLine();
          }, 1300);
        }
      }
      typeChar();
    }
    typeLine();
  }

  initTerminal();
  document.addEventListener('astro:page-load', initTerminal);
</script>
