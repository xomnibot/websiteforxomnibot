---
/** Credibility strip from siteConfig.stats. */
interface Props {
  stats: readonly { label: string; value: string }[];
}
const { stats } = Astro.props;
---

<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4">
  {
    stats.map((s) => (
      <div class="bg-elevated px-5 py-6 sm:px-6">
        <dd class="font-mono text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{s.value}</dd>
        <dt class="mt-1.5 text-sm text-muted">{s.label}</dt>
      </div>
    ))
  }
</dl>
