---
/** timeline as `git log --graph --oneline`: commit dots on a branch line, deterministic hashes, Tool commits branch off. */
import { timeline } from '@/data/timeline';
import { ArrowUpRight } from '@lucide/astro';

const hash = (s: string) => {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
    h = (h ^ (h >>> 13)) >>> 0;
  }
  return h.toString(16).padStart(8, '0').slice(0, 7);
};
const tone: Record<string, string> = {
  Platform: 'text-accent-2',
  Tool: 'text-accent',
  Research: 'text-red',
  Milestone: 'text-amber',
  CTF: 'text-green',
};
const dot: Record<string, string> = {
  Platform: 'bg-accent-2',
  Tool: 'bg-accent',
  Research: 'bg-red',
  Milestone: 'bg-amber',
  CTF: 'bg-green',
};
---

<ol class="gitlog relative">
  {
    timeline.map((t, i) => {
      const branch = t.category === 'Tool';
      const prevBranch = i > 0 && timeline[i - 1].category === 'Tool';
      const nextBranch = i < timeline.length - 1 && timeline[i + 1].category === 'Tool';
      return (
        <li data-reveal class:list={['commit relative grid grid-cols-[3.25rem_1fr]', branch && 'is-branch']}>
          <div class="graph relative" aria-hidden="true">
            <span class="main-line absolute left-[0.75rem] top-0 bottom-0 w-px bg-line-strong" style={i === 0 ? 'top:0.6rem' : i === timeline.length - 1 ? 'bottom:auto;height:0.6rem' : ''}></span>
            {branch && (
              <>
                {!prevBranch && <span class="fork fork-in"></span>}
                <span class="lane absolute left-[1.875rem] w-px bg-accent/50" style={`top:${prevBranch ? '0' : '0.7rem'};bottom:${nextBranch ? '0' : '0.7rem'}`}></span>
                {!nextBranch && <span class="fork fork-out"></span>}
              </>
            )}
            <span class:list={['dot absolute top-[0.35rem] size-[0.6875rem] rounded-full ring-4 ring-bg', dot[t.category], branch ? 'left-[1.5625rem]' : 'left-[0.5rem]']}></span>
          </div>
          <div class:list={['min-w-0 pl-1', i < timeline.length - 1 && 'pb-8']}>
            <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[0.8125rem] leading-6">
              <span class="text-accent-2">{hash(t.title + t.year)}</span>
              <span class="rounded border border-line-strong bg-surface px-1.5 text-[0.6875rem] font-medium text-fg">
                <span class="text-subtle">tag:</span> {t.year}
              </span>
              <span class:list={['text-[0.6875rem] uppercase tracking-[0.1em]', tone[t.category]]}>{t.category}</span>
            </p>
            <h3 class="mt-1 text-base font-medium leading-snug tracking-[-0.01em] text-fg">
              {t.link ? (
                <a href={t.link} class="group inline-flex items-baseline gap-1 hover:text-accent">
                  {t.title}
                  <ArrowUpRight class="size-3.5 translate-y-0.5 text-subtle transition-transform group-hover:-translate-y-px group-hover:translate-x-0.5 group-hover:text-accent" />
                </a>
              ) : (
                t.title
              )}
            </h3>
            <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{t.description}</p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .fork {
    position: absolute;
    left: 0.75rem;
    width: 1.125rem;
    height: 0.7rem;
    border: 0 solid color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .fork-in {
    top: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-top-right-radius: 0.75rem;
    height: 0.7rem;
  }
  .fork-out {
    bottom: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-bottom-right-radius: 0.75rem;
    height: 0.7rem;
  }
</style>
