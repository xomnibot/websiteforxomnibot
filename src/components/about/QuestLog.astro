---
/** learningPath as a quest log: status glyph, name, note, and a three-state progress bar. */
import { learningPath } from '@/data/about';
import { Check } from '@lucide/astro';

const state = {
  Completed: { tone: 'text-accent', label: 'Completed', pct: '100%' },
  'In progress': { tone: 'text-amber', label: 'In progress', pct: '55%' },
  Next: { tone: 'text-subtle', label: 'Next up', pct: '0%' },
} as const;
---

<ol class="overflow-hidden rounded-xl border border-line bg-elevated">
  {
    learningPath.map((item, i) => {
      const s = state[item.status];
      return (
        <li data-reveal class:list={['quest grid gap-x-4 gap-y-3 px-4 py-5 sm:grid-cols-[2rem_1fr_15rem] sm:items-center sm:px-6', i > 0 && 'border-t border-line']}>
          <span aria-hidden="true" class:list={['hidden size-8 items-center justify-center rounded-full border font-mono text-sm sm:flex', item.status === 'Completed' && 'border-accent/40 bg-accent/10 text-accent', item.status === 'In progress' && 'border-amber/40 bg-amber/10 text-amber', item.status === 'Next' && 'border-line-strong text-subtle']}>
            {item.status === 'Completed' ? <Check class="size-4" /> : item.status === 'In progress' ? '◐' : '○'}
          </span>
          <div class="min-w-0">
            <p class="font-medium leading-snug text-fg">
              <span aria-hidden="true" class:list={['mr-2 font-mono sm:hidden', s.tone]}>{item.status === 'Completed' ? '✓' : item.status === 'In progress' ? '◐' : '○'}</span>{item.name}
            </p>
            <p class="mt-1 text-sm text-muted">{item.note}</p>
          </div>
          <div>
            <p class:list={['mb-1.5 flex items-center justify-between font-mono text-[0.6875rem] uppercase tracking-[0.1em]', s.tone]}>
              <span>{s.label}</span>
            </p>
            <div class="bar h-1.5 overflow-hidden rounded-full bg-surface ring-1 ring-inset ring-line" role="img" aria-label={s.label}>
              <div class:list={['h-full rounded-full', item.status === 'Completed' && 'bg-accent', item.status === 'In progress' && 'bar-live']} style={`width:${s.pct}`}></div>
            </div>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .bar-live {
    background: linear-gradient(90deg, var(--status-amber), color-mix(in srgb, var(--status-amber) 55%, var(--bg-elevated)), var(--status-amber));
    background-size: 220% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar-live {
      animation: shimmer 2.4s linear infinite;
    }
  }
  @keyframes shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: 0 0;
    }
  }
</style>
