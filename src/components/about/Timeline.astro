---
/** Vertical timeline for /about, sourced from src/data/timeline.ts. */
import type { TimelineMilestone } from '@/data/timeline';
import Badge from '@/components/ui/Badge.astro';
import type { BadgeTone } from '@/components/ui/Badge.astro';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  milestones: TimelineMilestone[];
  class?: string;
}

const { milestones, class: className = '' } = Astro.props;

const categoryTone: Record<TimelineMilestone['category'], BadgeTone> = {
  Research: 'blue',
  Tool: 'accent',
  CTF: 'green',
  Platform: 'amber',
  Milestone: 'neutral',
};
---

<ol class={`relative space-y-8 border-l border-line pl-6 ${className}`}>
  {
    milestones.map((m) => (
      <li class="relative">
        <span class="absolute -left-[calc(1.5rem+5px)] top-1 size-2.5 rounded-full border-2 border-bg bg-accent" />
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs text-subtle">{m.year}</span>
          <Badge tone={categoryTone[m.category]}>{m.category}</Badge>
        </div>
        {m.link ? (
          <a href={m.link} class="group mt-1.5 inline-flex items-center gap-1.5 font-semibold text-fg hover:text-accent">
            {m.title}
            <ArrowUpRight class="size-3.5 text-subtle transition-colors group-hover:text-accent" />
          </a>
        ) : (
          <p class="mt-1.5 font-semibold text-fg">{m.title}</p>
        )}
        <p class="mt-1 max-w-2xl text-sm text-muted">{m.description}</p>
      </li>
    ))
  }
</ol>
