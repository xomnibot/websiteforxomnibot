---
/**
 * Detail-page header: breadcrumb, badges, title, description, meta row
 * (date / updated / reading time), tags, full-width cover image.
 */
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import Tag from '@/components/ui/Tag.astro';
import EntryBadges from './EntryBadges.astro';
import { collectionMeta, entryReadingTime, type AnyEntry } from '@/lib/collections';
import { formatDate, formatIsoDate } from '@/lib/utils';

interface Props {
  entry: AnyEntry;
  description: string;
}

const { entry, description } = Astro.props;
const meta = collectionMeta[entry.collection];
---

<header class="space-y-5">
  <TerminalPrompt path={`~${meta.href}/${entry.id}`} />

  <EntryBadges entry={entry} />

  <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{entry.data.title}</h1>

  {description && <p class="max-w-3xl text-lg text-muted">{description}</p>}

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-subtle">
    <time datetime={formatIsoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
    {entry.data.updated && (
      <span class="inline-flex items-center gap-1">
        Updated
        <time datetime={formatIsoDate(entry.data.updated)}>{formatDate(entry.data.updated)}</time>
      </span>
    )}
    <span>{entryReadingTime(entry)}</span>
  </div>

  {entry.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {entry.data.tags.map((tag) => (
        <Tag tag={tag} />
      ))}
    </div>
  )}

  {entry.data.cover && (
    <img
      src={entry.data.cover}
      alt={entry.data.coverAlt ?? ''}
      width="1200"
      height="500"
      fetchpriority="high"
      class="aspect-[2/1] max-h-[520px] w-full rounded-xl border border-line object-cover sm:aspect-[12/5]"
    />
  )}
</header>
