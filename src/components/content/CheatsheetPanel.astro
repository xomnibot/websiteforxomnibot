---
/**
 * Renders cheatsheet `sections` as grouped command rows (command in mono
 * code with a copy button, description, optional example) plus a quick
 * filter input that filters commands/sections client-side. Below this, the
 * markdown body still renders normally in PostLayout.
 */
import CopyButton from './CopyButton.astro';
import { Search } from '@lucide/astro';
import type { CheatsheetSection } from '@/lib/schemas';

interface Props {
  sections: CheatsheetSection[];
}

const { sections } = Astro.props;
const hasContent = sections.some((s) => s.items.length > 0);
---

{hasContent && (
  <section class="mb-8 space-y-5 rounded-xl border border-line bg-elevated p-5" data-cheatsheet>
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-mono text-xs uppercase tracking-widest text-accent">// commands</h2>
      <span data-cheatsheet-count class="font-mono text-xs text-subtle"></span>
    </div>

    <div class="relative">
      <Search class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-subtle" aria-hidden="true" />
      <input
        type="search"
        data-cheatsheet-filter
        placeholder="Filter commands..."
        aria-label="Filter commands"
        class="w-full rounded-lg border border-line bg-bg py-2.5 pl-9 pr-3.5 text-sm text-fg placeholder:text-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      />
    </div>

    {sections.map((section) => section.items.length > 0 && (
      <div data-cheatsheet-section class="space-y-2">
        <h3 class="font-mono text-sm font-semibold text-fg">{section.title}</h3>
        <div class="space-y-2">
          {section.items.map((item) => (
            <div
              data-cheatsheet-item
              data-search={`${item.command} ${item.description} ${item.example ?? ''}`.toLowerCase()}
              class="rounded-lg border border-line bg-surface p-3"
            >
              <div class="flex items-start justify-between gap-3">
                <code class="min-w-0 flex-1 overflow-x-auto whitespace-pre font-mono text-sm text-fg">{item.command}</code>
                <CopyButton text={item.command} />
              </div>
              <p class="mt-1.5 text-sm text-muted">{item.description}</p>
              {item.example && (
                <code class="mt-2 block overflow-x-auto whitespace-pre rounded-md bg-elevated px-2.5 py-1.5 font-mono text-xs text-subtle">
                  {item.example}
                </code>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

    <p data-cheatsheet-empty hidden class="py-6 text-center text-sm text-muted">No commands match your filter.</p>
  </section>
)}

<script>
  function initCheatsheetFilter() {
    const panel = document.querySelector<HTMLElement>('[data-cheatsheet]');
    if (!panel) return;
    const input = panel.querySelector<HTMLInputElement>('[data-cheatsheet-filter]');
    if (!input) return;
    const items = Array.from(panel.querySelectorAll<HTMLElement>('[data-cheatsheet-item]'));
    const sections = Array.from(panel.querySelectorAll<HTMLElement>('[data-cheatsheet-section]'));
    const empty = panel.querySelector<HTMLElement>('[data-cheatsheet-empty]');
    const countEl = panel.querySelector<HTMLElement>('[data-cheatsheet-count]');

    function apply() {
      const q = (input as HTMLInputElement).value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const match = !q || (item.dataset.search ?? '').includes(q);
        item.hidden = !match;
        if (match) visible += 1;
      });
      sections.forEach((section) => {
        const anyVisible = Array.from(section.querySelectorAll<HTMLElement>('[data-cheatsheet-item]')).some(
          (i) => !i.hidden,
        );
        section.hidden = !anyVisible;
      });
      if (countEl) countEl.textContent = `${visible} command${visible === 1 ? '' : 's'}`;
      if (empty) empty.hidden = visible !== 0;
    }

    input.addEventListener('input', apply);
    apply();
  }

  initCheatsheetFilter();
  document.addEventListener('astro:page-load', initCheatsheetFilter);
</script>
