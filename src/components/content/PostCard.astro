---
/**
 * Card for any collection entry. Whole card is clickable, carries
 * data-* attributes consumed by FilterBar's client-side filtering script,
 * and falls back to a gradient + mono glyph when there's no cover image.
 *
 * Tags are rendered as plain <span> chips (not links) since the entire card
 * is already an <a> — nested interactive anchors are invalid HTML and bad
 * for a11y/keyboard nav.
 */
import { cn } from '@/lib/utils';
import { formatDate, formatIsoDate } from '@/lib/utils';
import { entryHref, entryDescription, entryReadingTime, collectionMeta, type AnyEntry } from '@/lib/collections';
import Badge from '@/components/ui/Badge.astro';
import EntryBadges from './EntryBadges.astro';
import { Terminal, Bug, FolderGit2, FileText, ListChecks } from '@lucide/astro';

interface Props {
  entry: AnyEntry;
  featured?: boolean;
  /** Show a neutral badge naming the collection (used on cross-collection listings like /tags/[tag]). */
  showCollectionBadge?: boolean;
  class?: string;
}

const { entry, featured = false, showCollectionBadge = false, class: className } = Astro.props;

const href = entryHref(entry);
const description = entryDescription(entry);
const date = entry.data.date;
const readingTime = entryReadingTime(entry);
const tags = entry.data.tags.slice(0, 3);

const glyphs = {
  writeups: Terminal,
  research: Bug,
  projects: FolderGit2,
  blog: FileText,
  cheatsheets: ListChecks,
} as const;
const Glyph = glyphs[entry.collection];

const searchText = [entry.data.title, description, ...entry.data.tags].join(' ').toLowerCase();
---

<a
  href={href}
  data-post-card
  data-spotlight
  data-search={searchText}
  data-category={entry.data.category}
  data-platform={entry.collection === 'writeups' ? entry.data.platform : undefined}
  data-difficulty={entry.collection === 'writeups' ? entry.data.difficulty ?? '' : undefined}
  data-severity={entry.collection === 'research' ? entry.data.severity ?? '' : undefined}
  data-status={entry.collection === 'projects' ? entry.data.status : undefined}
  class={cn(
    'group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-elevated transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40',
    featured && 'sm:flex-row',
    className,
  )}
>
  <div
    class={cn(
      'relative aspect-[16/9] w-full shrink-0 overflow-hidden bg-surface',
      featured && 'sm:aspect-auto sm:w-2/5',
    )}
  >
    {entry.data.cover ? (
      <img
        src={entry.data.cover}
        alt={entry.data.coverAlt ?? ''}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="bg-grid absolute inset-0 flex items-center justify-center bg-surface">
        <Glyph class="size-10 text-muted/30" aria-hidden="true" />
      </div>
    )}
  </div>

  <div class="relative z-[2] flex flex-1 flex-col gap-3 p-5">
    <div class="flex flex-wrap items-center gap-1.5">
      {featured && <Badge tone="accent">Featured</Badge>}
      {showCollectionBadge && <Badge tone="neutral">{collectionMeta[entry.collection].singular}</Badge>}
      <EntryBadges entry={entry} class="contents" />
    </div>

    <h3 class={cn('font-semibold tracking-tight text-fg', featured ? 'text-xl' : 'text-lg')}>{entry.data.title}</h3>
    {description && <p class="line-clamp-2 text-sm text-muted">{description}</p>}

    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 font-mono text-xs text-subtle">
      <time datetime={formatIsoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="inline-flex items-center rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-muted">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
