---
/** Shared card shell for the collection-specific info panels below. */
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  icon?: any;
  class?: string;
}

const { title, icon: Icon, class: className } = Astro.props;
---

<section class={cn('mb-8 rounded-xl border border-line bg-elevated p-5', className)}>
  <h2 class="mb-4 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent">
    {Icon && <Icon class="size-3.5" />} {title}
  </h2>
  <slot />
</section>
