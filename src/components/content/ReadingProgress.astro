---
/**
 * Thin fixed progress bar at the very top of the viewport, tracking scroll
 * position through the page. The scroll/resize listeners are registered
 * ONCE at module scope (persistent `window`, never re-added on navigation);
 * only the `bar` element reference and initial paint are refreshed on
 * astro:page-load, per FOUNDATION pattern #4 (avoid duplicate listeners).
 */
---

<div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5">
  <div data-reading-progress class="h-full w-0 origin-left bg-accent"></div>
</div>

<script>
  let bar: HTMLElement | null = null;

  function update() {
    if (!bar) return;
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
    bar.style.width = `${progress * 100}%`;
  }

  function initReadingProgress() {
    bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    update();
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>
