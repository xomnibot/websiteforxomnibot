---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Hero from '@/components/home/Hero.astro';
import StatsRow from '@/components/home/StatsRow.astro';
import FeaturedGrid from '@/components/home/FeaturedGrid.astro';
import LatestList from '@/components/home/LatestList.astro';
import CollectionTiles from '@/components/home/CollectionTiles.astro';
import ClosingCta from '@/components/home/ClosingCta.astro';
import { siteConfig } from '@/lib/site';
import { getPublished, getAllPublished, type CollectionKey } from '@/lib/collections';
import { COLLECTIONS } from '@/lib/schemas';

const [allEntries, ...perCollection] = await Promise.all([
  getAllPublished(),
  ...COLLECTIONS.map((c) => getPublished(c)),
]);
const counts = Object.fromEntries(COLLECTIONS.map((c, i) => [c, perCollection[i].length])) as Record<
  CollectionKey,
  number
>;

const tagCount = new Set(allEntries.flatMap((e) => e.data.tags ?? [])).size;
const stats = [
  { label: 'Writeups published', value: String(counts.writeups) },
  { label: 'Posts in total', value: String(allEntries.length) },
  { label: 'Topics covered', value: String(tagCount) },
  { label: 'Hacking since', value: '2023' },
];

const featured = allEntries.filter((e) => e.data.featured).slice(0, 3);
const latest = allEntries.slice(0, 6);
const pageTitle = `${siteConfig.name} — ${siteConfig.tagline}`;
---

<BaseLayout title={pageTitle} description={siteConfig.description}>
  <Hero />

  <Container class="py-12 sm:py-16">
    <StatsRow stats={stats} />
  </Container>

  {
    featured.length > 0 && (
      <Container class="pb-20 sm:pb-28">
        <SectionHeading
          eyebrow="// featured"
          title="Start here"
          description="Selected writeups, research and tools."
          class="mb-8"
        />
        <FeaturedGrid entries={featured} />
      </Container>
    )
  }

  <Container class="pb-20 sm:pb-28">
    <SectionHeading eyebrow="// latest" title="Latest posts" class="mb-8" />
    <LatestList entries={latest} />
  </Container>

  <Container class="pb-20 sm:pb-28">
    <SectionHeading eyebrow="// explore" title="Explore by topic" class="mb-8" />
    <CollectionTiles counts={counts} />
  </Container>

  <Container class="pb-20 sm:pb-28">
    <ClosingCta />
  </Container>
</BaseLayout>
