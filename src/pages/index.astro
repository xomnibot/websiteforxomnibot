---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Reveal from '@/components/home/Reveal.astro';
import PhaseRail from '@/components/home/PhaseRail.astro';
import PhaseSection from '@/components/home/PhaseSection.astro';
import Enumerate from '@/components/home/Enumerate.astro';
import Exploit from '@/components/home/Exploit.astro';
import Escalate from '@/components/home/Escalate.astro';
import Persist from '@/components/home/Persist.astro';
import Exfil from '@/components/home/Exfil.astro';
import { siteConfig } from '@/lib/site';
import { getPublished, getAllPublished, type CollectionKey, type AnyEntry } from '@/lib/collections';
import { COLLECTIONS } from '@/lib/schemas';

const [allEntries, ...perCollection] = await Promise.all([
  getAllPublished(),
  ...COLLECTIONS.map((c) => getPublished(c)),
]);
const counts = Object.fromEntries(COLLECTIONS.map((c, i) => [c, perCollection[i].length])) as Record<
  CollectionKey,
  number
>;

const tagCount = new Set(allEntries.flatMap((e) => e.data.tags ?? [])).size;
const stats = [
  { label: 'Writeups published', value: String(counts.writeups), count: true },
  { label: 'Posts in total', value: String(allEntries.length), count: true },
  { label: 'Topics covered', value: String(tagCount), count: true },
  { label: 'Hacking since', value: '2023' },
];

// "Boxes I've broken" is writeups only: featured writeups first, then the newest ones.
const writeups = perCollection[COLLECTIONS.indexOf('writeups')] as AnyEntry[];
const featured: AnyEntry[] = writeups.filter((e) => e.data.featured).slice(0, 3);
for (const w of writeups) {
  if (featured.length >= 3) break;
  if (!featured.includes(w)) featured.push(w);
}
const latest = allEntries.slice(0, 6);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <PhaseRail />
  <Reveal />
  <section id="recon" data-phase="recon"><Hero /></section>
  <PhaseSection id="enumerate" alt bleed><Enumerate stats={stats} /></PhaseSection>
  {featured.length > 0 && <PhaseSection id="exploit"><Exploit entries={featured} /></PhaseSection>}
  <PhaseSection id="escalate" alt><Escalate /></PhaseSection>
  <PhaseSection id="persist"><Persist entries={latest} counts={counts} /></PhaseSection>
  <PhaseSection id="exfil" alt><Exfil /></PhaseSection>
</BaseLayout>
