---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import VideoCard from '@/components/home/VideoCard.astro';
import { siteConfig } from '@/lib/site';
import { youtubeVideos } from '@/data/youtube';

const sorted = [...youtubeVideos].sort(
  (a, b) => new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf(),
);
---

<BaseLayout title="YouTube" description={`Video walkthroughs and technical deep dives from ${siteConfig.name} on YouTube.`}>
  <Container class="pt-14 pb-16 sm:pt-20">
    <TerminalPrompt path="~/youtube" />
    <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight text-fg sm:text-5xl">Video breakdowns</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          The same research and writeups, walked through on camera — web security, Active Directory, and reverse
          engineering, explained step by step.
        </p>
      </div>
      <Button href={siteConfig.socials.youtube} target="_blank" rel="noreferrer" variant="primary" size="lg" class="shrink-0">
        <BrandIcon name="youtube" class="size-4" />
        Subscribe on YouTube
      </Button>
    </div>
  </Container>

  <Container class="pb-20 sm:pb-28">
    {
      sorted.length === 0 ? (
        <div class="rounded-xl border border-line bg-elevated p-10 text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-accent">// no videos yet</p>
          <p class="mt-3 text-muted">
            Nothing published on the channel yet — subscribe to get notified the moment the first video drops.
          </p>
          <div class="mt-5 flex justify-center">
            <Button href={siteConfig.socials.youtube} target="_blank" rel="noreferrer" variant="secondary">
              <BrandIcon name="youtube" class="size-4" />
              Visit the channel
            </Button>
          </div>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {sorted.map((video) => (
            <VideoCard video={video} />
          ))}
        </div>
      )
    }
  </Container>

  <script is:inline>
    (function () {
      if (window.__ytEmbedDelegated) return;
      window.__ytEmbedDelegated = true;
      document.addEventListener('click', function (e) {
        var trigger = e.target && e.target.closest ? e.target.closest('[data-yt-play]') : null;
        if (!trigger) return;
        e.preventDefault();
        var card = trigger.closest('[data-yt-card]');
        var media = card ? card.querySelector('[data-yt-media]') : null;
        var videoId = card ? card.getAttribute('data-video-id') : null;
        if (!card || !media || !videoId) return;
        var title = card.getAttribute('data-video-title') || 'YouTube video';
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1';
        iframe.title = title;
        iframe.loading = 'lazy';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 size-full';
        iframe.style.border = '0';
        media.innerHTML = '';
        media.appendChild(iframe);
      });
    })();
  </script>
</BaseLayout>
