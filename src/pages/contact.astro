---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import { siteConfig } from '@/lib/site';
import { Mail, Copy, KeyRound, ShieldAlert, Clock } from '@lucide/astro';

const socialLinks = [
  { href: siteConfig.socials.github, label: 'GitHub', hint: '@xomnibot', brand: 'github' as const },
  { href: siteConfig.socials.youtube, label: 'YouTube', hint: '@xomnibot', brand: 'youtube' as const },
  { href: siteConfig.socials.linkedin, label: 'LinkedIn', hint: 'in/xomnibot', brand: 'linkedin' as const },
  { href: siteConfig.socials.x, label: 'X', hint: '@xomnibot', brand: 'x' as const },
];
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.name} — email, socials, and responsible disclosure guidance.`}>
  <Container class="pt-14 pb-16 sm:pt-20">
    <TerminalPrompt path="~/contact" />
    <h1 class="mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-fg sm:text-5xl">Get in touch.</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">
      No forms, no gatekeeping — just direct channels. Reach out for research collaborations, questions about a
      writeup, or a security report.
    </p>
  </Container>

  <Container class="pb-16 sm:pb-24">
    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Email -->
      <div class="rounded-xl border border-line bg-elevated p-5 sm:p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// email</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface text-accent">
            <Mail class="size-4" />
          </span>
          <a href={`mailto:${siteConfig.socials.email}`} class="font-mono text-sm text-fg hover:text-accent">
            {siteConfig.socials.email}
          </a>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <Button href={`mailto:${siteConfig.socials.email}`} variant="primary" size="sm">
            <Mail class="size-3.5" />
            Send an email
          </Button>
          <button
            type="button"
            data-email={siteConfig.socials.email}
            onclick="window.__copyEmail(this)"
            class="inline-flex h-8 items-center justify-center gap-2 rounded-lg border border-line-strong bg-elevated px-3 text-sm text-fg transition-colors hover:border-accent/50 hover:bg-surface"
          >
            <Copy class="size-3.5" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>
      </div>

      <!-- GPG -->
      <div class="rounded-xl border border-line bg-elevated p-5 sm:p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// encrypt</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface text-accent">
            <KeyRound class="size-4" />
          </span>
          <p class="text-sm text-muted">Prefer encrypted mail? Grab the public GPG key.</p>
        </div>
        <div class="mt-4">
          <Button href={siteConfig.socials.gpg} target="_blank" rel="noreferrer" variant="secondary" size="sm">
            <KeyRound class="size-3.5" />
            Download GPG key
          </Button>
        </div>
      </div>
    </div>

    <!-- Socials -->
    <div class="mt-4 rounded-xl border border-line bg-elevated p-5 sm:p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">// elsewhere</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noreferrer"
              data-spotlight
              class="group relative flex items-center gap-3 overflow-hidden rounded-lg border border-line bg-surface p-3 transition-all hover:-translate-y-0.5 hover:border-accent/40"
            >
              <span class="relative z-[2] inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-line bg-elevated text-muted group-hover:text-accent">
                <BrandIcon name={s.brand} />
              </span>
              <span class="relative z-[2] min-w-0">
                <span class="block text-sm font-medium text-fg">{s.label}</span>
                <span class="block truncate font-mono text-xs text-subtle">{s.hint}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Responsible disclosure -->
    <div class="mt-4 rounded-xl border border-line bg-elevated p-5 sm:p-6">
      <div class="flex items-center gap-2">
        <ShieldAlert class="size-4 text-accent" />
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// responsible disclosure</p>
      </div>
      <h2 class="mt-2 text-lg font-semibold tracking-tight text-fg">Reporting a security issue</h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        If you've found a security issue with this site, one of the open-source tools linked from
        <a href="/projects" class="text-accent underline-offset-4 hover:underline">Projects</a>, or in something
        I've published, I'd genuinely appreciate a heads-up before any public disclosure.
      </p>
      <ul class="mt-4 space-y-2 text-sm text-muted">
        <li class="flex items-start gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
          Email a clear description of the issue, affected component, and reproduction steps to
          <span class="font-mono text-fg">{siteConfig.socials.email}</span> — encrypt with the GPG key above if the
          finding is sensitive.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
          Please avoid automated scanning that could degrade availability, and don't access or modify data that
          isn't yours.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
          Give me a reasonable window to investigate and fix the issue before any public write-up or disclosure.
        </li>
      </ul>
      <div class="mt-4 flex items-start gap-2 rounded-lg border border-line bg-surface p-3 text-xs text-subtle">
        <Clock class="mt-0.5 size-3.5 shrink-0" />
        <span>
          This is a personal project maintained in my spare time, so response times vary with complexity and
          workload — but every legitimate report gets read and acknowledged.
        </span>
      </div>
    </div>
  </Container>

  <script is:inline>
    window.__copyEmail = function (btn) {
      var email = btn.getAttribute('data-email');
      if (!email || !navigator.clipboard) return;
      navigator.clipboard.writeText(email).then(function () {
        var label = btn.querySelector('[data-copy-label]');
        if (!label) return;
        var original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(function () {
          label.textContent = original;
        }, 1500);
      });
    };
  </script>
</BaseLayout>
