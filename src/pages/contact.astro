---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import { siteConfig } from '@/lib/site';
import { Mail, Copy } from '@lucide/astro';

const socialLinks = [
  { href: siteConfig.socials.github, label: 'GitHub', hint: '@xomnibot', brand: 'github' as const },
];
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.name} — email and GitHub.`}>
  <Container class="pt-14 pb-16 sm:pt-20">
    <TerminalPrompt path="~/contact" />
    <h1 class="mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-fg sm:text-5xl">Get in touch.</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">
      No forms, no gatekeeping — just direct channels. Reach out for research collaborations, questions about a
      writeup, or a CTF team invite.
    </p>
  </Container>

  <Container class="pb-16 sm:pb-24">
    <div class="grid gap-4">
      <!-- Email -->
      <div class="rounded-xl border border-line bg-elevated p-5 sm:p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// email</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface text-accent">
            <Mail class="size-4" />
          </span>
          <a href={`mailto:${siteConfig.socials.email}`} class="font-mono text-sm text-fg hover:text-accent">
            {siteConfig.socials.email}
          </a>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <Button href={`mailto:${siteConfig.socials.email}`} variant="primary" size="sm">
            <Mail class="size-3.5" />
            Send an email
          </Button>
          <button
            type="button"
            data-email={siteConfig.socials.email}
            onclick="window.__copyEmail(this)"
            class="inline-flex h-8 items-center justify-center gap-2 rounded-lg border border-line-strong bg-elevated px-3 text-sm text-fg transition-colors hover:border-accent/50 hover:bg-surface"
          >
            <Copy class="size-3.5" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Socials -->
    <div class="mt-4 rounded-xl border border-line bg-elevated p-5 sm:p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">// elsewhere</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noreferrer"
              data-spotlight
              class="group relative flex items-center gap-3 overflow-hidden rounded-lg border border-line bg-surface p-3 transition-all hover:-translate-y-0.5 hover:border-accent/40"
            >
              <span class="relative z-[2] inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-line bg-elevated text-muted group-hover:text-accent">
                <BrandIcon name={s.brand} />
              </span>
              <span class="relative z-[2] min-w-0">
                <span class="block text-sm font-medium text-fg">{s.label}</span>
                <span class="block truncate font-mono text-xs text-subtle">{s.hint}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>

  <script is:inline>
    window.__copyEmail = function (btn) {
      var email = btn.getAttribute('data-email');
      if (!email || !navigator.clipboard) return;
      navigator.clipboard.writeText(email).then(function () {
        var label = btn.querySelector('[data-copy-label]');
        if (!label) return;
        var original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(function () {
          label.textContent = original;
        }, 1500);
      });
    };
  </script>
</BaseLayout>
