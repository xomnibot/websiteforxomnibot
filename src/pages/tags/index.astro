---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import { getAllTags } from '@/lib/collections';
import { Hash } from '@lucide/astro';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse every writeup, research post, project, and article by tag.">
  <Container class="space-y-8 py-12 sm:py-16">
    <div class="space-y-4">
      <TerminalPrompt path="~/tags" />
      <SectionHeading
        eyebrow="// tags"
        title="Tags"
        description="Every topic covered across writeups, research, projects, and the blog."
      />
      <p class="font-mono text-xs text-subtle">{tags.length} {tags.length === 1 ? "tag" : "tags"}</p>
    </div>

    {tags.length === 0 ? (
      <p class="text-muted">No tags yet.</p>
    ) : (
      <div class="flex flex-wrap gap-2.5">
        {tags.map((t) => (
          <a
            href={`/tags/${t.slug}`}
            data-spotlight
            class={`inline-flex items-center gap-1.5 min-h-10 rounded-lg border border-line bg-elevated px-3 py-1.5 font-mono text-muted transition-colors hover:border-accent/40 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent text-sm`}
          >
            <Hash class="size-3.5 text-subtle" aria-hidden="true" />
            {t.tag}
            <span class="rounded bg-surface px-1.5 text-xs text-subtle">{t.count}</span>
          </a>
        ))}
      </div>
    )}
  </Container>
</BaseLayout>
