---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import TerminalPrompt from '@/components/ui/TerminalPrompt.astro';
import SkillGroup from '@/components/about/SkillGroup.astro';
import Timeline from '@/components/about/Timeline.astro';
import { siteConfig } from '@/lib/site';
import { timeline } from '@/data/timeline';
import { bio, featuredProjects, capabilities, learningPath } from '@/data/about';
import Badge from '@/components/ui/Badge.astro';
import type { BadgeTone } from '@/components/ui/Badge.astro';
import { Swords, ShieldHalf, Code, BrainCircuit, Sparkles, Monitor, SquareTerminal, Cpu, PenTool, Check, ArrowUpRight, CircleCheck, CircleDot, Circle } from '@lucide/astro';

const projectStatusTone: Record<string, BadgeTone> = { Active: 'green', Stable: 'blue', Archived: 'neutral' };
const learningIcon = { Completed: CircleCheck, 'In progress': CircleDot, Next: Circle } as const;

const skillGroups = [
  { key: 'offensive', label: 'Offensive Security', icon: Swords, skills: siteConfig.skills.offensive },
  { key: 'defensive', label: 'Defensive Security', icon: ShieldHalf, skills: siteConfig.skills.defensive },
  { key: 'development', label: 'Development', icon: Code, skills: siteConfig.skills.development },
  { key: 'aiSecurity', label: 'AI Security', icon: BrainCircuit, skills: siteConfig.skills.aiSecurity },
];

const rig = [
  { label: 'OS', value: siteConfig.persona.rig.os, icon: Monitor },
  { label: 'Terminal', value: siteConfig.persona.rig.terminal, icon: SquareTerminal },
  { label: 'Editor', value: siteConfig.persona.rig.editor, icon: PenTool },
  { label: 'Hardware', value: siteConfig.persona.rig.hardware, icon: Cpu },
];
---

<BaseLayout
  title="About"
  description={`${siteConfig.persona.role} — mission, skills, setup, and background for ${siteConfig.name}.`}
>
  <Container class="pt-14 pb-16 sm:pt-20">
    <TerminalPrompt path="~/about" />
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
      Hi, I'm {siteConfig.persona.handle} — {siteConfig.persona.role}.
    </h1>
    {bio.map((para, i) => (
      <p class:list={['max-w-2xl text-muted', i === 0 ? 'mt-5 text-lg' : 'mt-3']}>{para}</p>
    ))}

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/contact" variant="primary">Get in touch</Button>
      <Button href="/writeups" variant="secondary">Read the writeups</Button>
    </div>
  </Container>

  <!-- Featured projects -->
  <Container class="pb-16 sm:pb-24">
    <SectionHeading eyebrow="// projects" title="Things I've built" class="mb-8" />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((p) => {
        const Tag = p.link ? 'a' : 'div';
        return (
          <Tag
            href={p.link}
            class:list={[
              'group flex flex-col rounded-xl border border-line bg-elevated p-5 sm:p-6',
              p.link && 'transition-colors hover:border-accent/40',
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-semibold tracking-tight text-fg group-hover:text-accent">
                {p.name}
                {p.link && <ArrowUpRight class="ml-1 inline size-3.5 text-subtle group-hover:text-accent" />}
              </h3>
              <Badge tone={projectStatusTone[p.status]}>{p.status}</Badge>
            </div>
            <p class="mt-2 text-sm text-muted">{p.summary}</p>
            <ul class="mt-4 space-y-2">
              {p.highlights.map((h) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <Check class="mt-0.5 size-3.5 shrink-0 text-accent" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
              {p.stack.map((s) => (
                <span class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-subtle">{s}</span>
              ))}
            </div>
          </Tag>
        );
      })}
    </div>
  </Container>

  <!-- Capabilities -->
  <Container class="pb-16 sm:pb-24">
    <SectionHeading eyebrow="// capabilities" title="What I can do" class="mb-8" />
    <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <div class="bg-elevated p-5 sm:p-6">
          <h3 class="font-semibold tracking-tight text-fg">{c.area}</h3>
          <ul class="mt-3 space-y-2">
            {c.points.map((pt) => (
              <li class="flex items-start gap-2 text-sm text-muted">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" />
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>

  <!-- Skills -->
  <Container class="pb-16 sm:pb-24">
    <SectionHeading eyebrow="// skills" title="What I work with" class="mb-8" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {skillGroups.map((g) => (
        <SkillGroup label={g.label} icon={g.icon} skills={g.skills} />
      ))}
    </div>
  </Container>

  <!-- Rig + fun facts -->
  <Container class="pb-16 sm:pb-24">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-xl border border-line bg-elevated p-5 sm:p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// rig</p>
        <h3 class="mt-1 text-lg font-semibold tracking-tight text-fg">The setup</h3>
        <dl class="mt-4 divide-y divide-line">
          {rig.map((row) => (
            <div class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
              <row.icon class="mt-0.5 size-4 shrink-0 text-subtle" />
              <div class="min-w-0">
                <dt class="font-mono text-[0.6875rem] uppercase tracking-wide text-subtle">{row.label}</dt>
                <dd class="mt-0.5 text-sm text-fg">{row.value}</dd>
              </div>
            </div>
          ))}
        </dl>
        <p class="mt-5 font-mono text-xs text-subtle">
          Primary languages: <span class="text-muted">{siteConfig.persona.primaryLanguages.join(', ')}</span>
        </p>
        <p class="mt-1.5 font-mono text-xs text-subtle">
          Go-to tools: <span class="text-muted">{siteConfig.persona.favoriteSecurityTools.join(', ')}</span>
        </p>
      </div>

      <div class="rounded-xl border border-line bg-elevated p-5 sm:p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">// fun facts</p>
        <h3 class="mt-1 text-lg font-semibold tracking-tight text-fg">A few things about me</h3>
        <ul class="mt-4 space-y-3">
          {siteConfig.persona.funFacts.map((fact) => (
            <li class="flex items-start gap-2.5 text-sm text-muted">
              <Sparkles class="mt-0.5 size-4 shrink-0 text-accent" />
              <span>{fact}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>

  <!-- Learning path -->
  <Container class="pb-16 sm:pb-24">
    <SectionHeading eyebrow="// learning" title="Learning path" class="mb-8" />
    <ol class="divide-y divide-line rounded-xl border border-line bg-elevated">
      {learningPath.map((item) => {
        const Icon = learningIcon[item.status];
        return (
          <li class="flex items-start gap-3 p-4 sm:items-center sm:p-5">
            <Icon class:list={['mt-0.5 size-4 shrink-0 sm:mt-0', item.status === 'Next' ? 'text-subtle' : 'text-accent']} />
            <div class="min-w-0 flex-1 sm:flex sm:items-center sm:justify-between sm:gap-6">
              <div class="min-w-0">
                <p class="font-medium text-fg">{item.name}</p>
                <p class="mt-0.5 text-sm text-muted">{item.note}</p>
              </div>
              <span class="mt-2 inline-block shrink-0 font-mono text-xs text-subtle sm:mt-0">{item.status}</span>
            </div>
          </li>
        );
      })}
    </ol>
  </Container>

  <!-- Timeline -->
  <Container class="pb-16 sm:pb-24">
    <SectionHeading eyebrow="// journey" title="Milestones" class="mb-8" />
    <Timeline milestones={timeline} />
  </Container>

  <!-- Socials + contact -->
  <Container class="pb-20 sm:pb-28">
    <div class="rounded-xl border border-line bg-elevated p-8 text-center sm:p-12">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">// connect</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">Let's talk security.</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Reach out about CTF teams, internships, project collaborations, or just to say hi.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <Button href="/contact" variant="primary">Contact me</Button>
        <a
          href={siteConfig.socials.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
          class="inline-flex size-10 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent/40 hover:text-accent"
        >
          <BrandIcon name="github" />
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>
