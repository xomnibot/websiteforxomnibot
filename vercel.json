{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/youtube",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/research/cve-2026-1337-oauth-bypass",
      "destination": "/research/oauth-redirect-uri-bypass-case-study",
      "permanent": true
    }
  ]
}
